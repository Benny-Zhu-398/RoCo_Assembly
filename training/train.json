{
  "dataset": {
    "repo_id": "rocochallenge2025/rocochallenge2026_Industrial_Assembly",
    "revision": "main",
    "video_backend": "pyav"
  },
  "use_policy_training_preset": true,
  "policy": {
    "type": "act",
    "device": "cuda",
    "push_to_hub": false,
    "n_obs_steps": 1,
    "chunk_size": 20,
    "n_action_steps": 20,
    "input_features": {
      "observation.state": {"type": "STATE", "shape": [44]},
      "observation.images.head": {"type": "VISUAL", "shape": [3, 240, 320]}
    },
    "output_features": {
      "action": {"type": "ACTION", "shape": [14]}
    },
    "normalization_mapping": {
      "STATE": "MEAN_STD",
      "VISUAL": "MEAN_STD",
      "ACTION": "MEAN_STD"
    }
  },
  "batch_size": 8,
  "steps": 10000,
  "save_freq": 2000,
  "log_freq": 100,
  "output_dir": "./outputs/train/act_stage1",
  "job_name": "act_stage1",
  "wandb": {
    "enable": false
  }
}